#!/bin/bash
set -u
# ============================================================
# intel-powerctl 应用生命周期入口（飞牛应用中心调用）
#   start  -> 加载 msr 内核模块，启动 Web 服务（TCP 59500 + 网关 socket）
#   stop   -> 停止 Web 服务（已生效的功耗设置保留，不回滚）
#   status -> 进程存活检查
# ============================================================
APPNAME="intel-powerctl"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APPDEST="${TRIM_APPDEST:-$(cd "$SCRIPT_DIR/.." && pwd)}"
PKGVAR="${TRIM_PKGVAR:-${APPDEST}/var}"
LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/app.pid"
SOCKET="${APPDEST}/app.sock"
DAEMON="${APPDEST}/server/server.py"
PORT=59500
PYTHON="$(command -v python3 || echo /usr/bin/python3)"

mkdir -p "$PKGVAR"

running_pid() {
    [ -r "$PID_FILE" ] || return 1
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null \
        && [ -r "/proc/$pid/cmdline" ] \
        && tr '\0' '\n' < "/proc/$pid/cmdline" | grep -Fxq -- "$DAEMON"; then
        printf '%s' "$pid"
        return 0
    fi
    rm -f "$PID_FILE"
    return 1
}

start_process() {
    if pid="$(running_pid)"; then
        echo "$APPNAME: already running (pid $pid)"
        return 0
    fi
    [ -r "$DAEMON" ] || { echo "$APPNAME: daemon missing: $DAEMON" >&2; return 1; }
    [ -x "$PYTHON" ] || { echo "$APPNAME: python3 is required" >&2; return 1; }

    # 写功耗墙必须通过 /dev/cpu/*/msr
    if ! ls /dev/cpu/0/msr >/dev/null 2>&1; then
        modprobe msr 2>/dev/null \
            || echo "$APPNAME: modprobe msr 失败，UI 可打开但无法读写功耗" >&2
    fi

    rm -f "$SOCKET"
    : > "$LOG_FILE"
    nohup "$PYTHON" "$DAEMON" \
        --port "$PORT" \
        --socket "$SOCKET" \
        >> "$LOG_FILE" 2>&1 &
    local newpid=$!
    echo "$newpid" > "$PID_FILE"

    # 等待网关 socket 就绪
    local count=0
    while [ ! -S "$SOCKET" ] && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        kill -0 "$newpid" 2>/dev/null || break
    done
    if [ ! -S "$SOCKET" ] && ! kill -0 "$newpid" 2>/dev/null; then
        echo "$APPNAME: gateway socket did not start" >&2
        return 1
    fi
    echo "$APPNAME: started (pid $newpid, port $PORT)"
    return 0
}

stop_process() {
    local pid
    if ! pid="$(running_pid)"; then
        rm -f "$SOCKET"
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    local count=0
    while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$SOCKET"
    echo "$APPNAME: stopped（功耗设置保持当前值不变）"
    return 0
}

case "${1:-}" in
    start) start_process ;;
    stop) stop_process ;;
    status) running_pid >/dev/null && exit 0 || exit 3 ;;
    *) exit 1 ;;
esac
